{
  "name": "@axiocnc/desktop",
  "version": "0.0.89",
  "description": "AxioCNC Desktop - Electron wrapper for the CNC control server",
  "author": "Ryan Steckler <axiocnc@ryansinbox.com>",
  "homepage": "https://github.com/rsteckler/axiocnc",
  "main": "dist/bootstrap.js",
  "private": true,
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:compile",
    "build:clean": "rm -rf dist",
    "build:compile": "babel src -d dist --config-file ../../babel.config.js"
  },
  "dependencies": {
    "@axiocnc/server": "workspace:*",
    "chalk": "~4.1.1",
    "debug": "^4.3.1",
    "electron-store": "~8.1.0",
    "find-up": "3.0.0",
    "lodash": "~4.17.11",
    "mkdirp": "~0.5.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "40.8.3",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "config": "electron-builder.config.js"
  }
}
