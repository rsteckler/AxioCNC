{
  "name": "@axiocnc/server",
  "version": "0.0.89",
  "description": "AxioCNC Server - Express API + Socket.IO backend",
  "private": true,
  "main": "dist/cli.js",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:compile && pnpm run build:copy",
    "build:clean": "rm -rf dist",
    "build:compile": "babel src -d dist --config-file ../../babel.config.js",
    "build:i18n": "i18next-scanner --config ../../i18next-scanner.server.config.js \"src/**/*.{html,js,jsx}\" \"!src/i18n/**\" \"!**/node_modules/**\"",
    "build:copy": "node ../../developers/scripts/packaging/copy-server-assets.js",
    "build:copy:assets": "mkdir -p dist && cp -af assets dist/ 2>/dev/null || true",
    "build:copy:i18n": "mkdir -p dist && cp -af src/i18n dist/",
    "build:copy:views": "mkdir -p dist && cp -af src/views dist/",
    "build:copy:config": "mkdir -p dist/config && cp -af src/config/*.json dist/config/ 2>/dev/null || true",
    "build:copy:package": "cp -af package.json dist/"
  },
  "dependencies": {
    "@axiocnc/shared": "workspace:*",
    "@axiocnc/web": "workspace:*",
    "@serialport/parser-readline": "^10.0.0",
    "bcrypt-nodejs": "0.0.3",
    "body-parser": "~1.20.3",
    "chalk": "~4.1.1",
    "commander": "~9.1.0",
    "compression": "~1.7.4",
    "connect-multiparty": "~2.2.0",
    "connect-restreamer": "~1.0.3",
    "consolidate": "~0.15.1",
    "cookie-parser": "~1.4.4",
    "core-js": "~3.26.1",
    "debug": "~4.4.3",
    "deep-keys": "~0.5.0",
    "dotenv": "^16.6.1",
    "ensure-array": "^1.0.0",
    "ensure-type": "^1.5.1",
    "errorhandler": "~1.5.0",
    "escodegen": "~1.11.1",
    "esprima": "~4.0.1",
    "expand-tilde": "~2.0.2",
    "express": "~4.22.0",
    "express-jwt": "~5.3.1",
    "express-session": "~1.16.1",
    "gcode-parser": "^2.2.0",
    "hogan.js": "~3.0.2",
    "http-proxy": "~1.18.1",
    "i18next": "~15.0.9",
    "i18next-express-middleware": "~1.8.0",
    "i18next-node-fs-backend": "~2.1.3",
    "is-electron": "~2.2.1",
    "jsonwebtoken": "~9.0.0",
    "lodash": "~4.17.11",
    "method-override": "~3.0.0",
    "minimatch": "~3.1.4",
    "mkdirp": "~0.5.1",
    "morgan": "~1.9.1",
    "range_check": "~1.4.0",
    "regenerator-runtime": "~0.13.10",
    "registry-auth-token": "~3.4.0",
    "registry-url": "~5.1.0",
    "serialport": "^10.0.0",
    "serve-favicon": "~2.5.0",
    "serve-static": "~1.16.0",
    "session-file-store": "latest",
    "shortid": "~2.2.14",
    "socket.io": "~2.5.0",
    "socketio-jwt": "~4.5.0",
    "spawn-default-shell": "~2.0.0",
    "superagent": "~3.8.3",
    "uuid": "~3.3.2",
    "watch": "~1.0.2",
    "webappengine": "~1.2.0",
    "winston": "~3.14.1",
    "zod": "^4.3.5"
  }
}
