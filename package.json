{
  "name": "axiocnc",
  "version": "0.0.89",
  "description": "A web-based interface for CNC milling controller running Grbl, Marlin, Smoothieware, or TinyG",
  "homepage": "https://github.com/rsteckler/axiocnc",
  "author": "Cheton Wu <cheton@gmail.com>",
  "maintainer": "Ryan Steckler <admin@axiocnc.com>",
  "main": "./dist/cli.js",
  "bin": "./apps/server/bin/axiocnc",
  "files": [
    "apps/server/bin",
    "dist",
    "static"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:rsteckler/axiocnc.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "preferGlobal": true,
  "scripts": {
    "dev:start-server": "(test -d node_modules/.bin/nodemon || pnpm install) && nodemon --config nodemon.server.json",
    "dev:start-app": "cd apps/web && pnpm dev",
    "dev:start-electron": "nodemon --config nodemon.electron.json",
    "dev:grblsim:setup": "pnpm dev:grblsim:clone && pnpm dev:grblsim:build && pnpm dev:grblsim:enable",
    "dev:grblsim:run": "bash developers/scripts/grblsim/grblsim-run.sh",
    "dev:grblsim:clone": "bash developers/scripts/grblsim/grblsim-clone.sh",
    "dev:grblsim:build": "bash developers/scripts/grblsim/grblsim-build.sh",
    "dev:grblsim:clean": "bash developers/scripts/grblsim/grblsim-clean.sh",
    "dev:grblsim:clean:all": "bash developers/scripts/grblsim/grblsim-clean.sh --all",
    "dev:grblsim:enable": "bash developers/scripts/grblsim/grblsim-enable.sh",
    "dev:web:start-all": "pnpm dev:web:validate-links && concurrently \"pnpm dev:web:start-user-docs\" \"pnpm dev:web:start-dev-docs\" \"pnpm dev:web:start-static\"",
    "dev:web:start-static": "node developers/scripts/start-static-site.js",
    "dev:web:start-user-docs": "cd website/docs/user && PORT=3000 pnpm start",
    "dev:web:start-dev-docs": "cd website/docs/developer && PORT=3001 pnpm start",
    "dev:web:validate-links": "bash developers/scripts/validate-docs-links.sh",
    "dev:web:start-all:skip-validation": "concurrently \"pnpm dev:web:start-user-docs\" \"pnpm dev:web:start-dev-docs\" \"pnpm dev:web:start-static\"",
    "test:test": "tap apps/server/test/**/*.js --allow-incomplete-coverage --timeout=0 --node-arg=--require --node-arg=@babel/register",
    "test:coverage": "tap apps/server/test/**/*.js --coverage-report=text --coverage-report=html --no-browser --node-arg=--require --node-arg=@babel/register",
    "test:lint": "concurrently --kill-others-on-fail --names \"test:lint:i18n,test:lint:eslint,test:lint:web\" \"pnpm test:lint:i18n\" \"pnpm test:lint:eslint\" \"pnpm test:lint:web\"",
    "test:lint:i18n": "bash -c 'find apps/{web,server}/src/i18n -type f -name \"*.json\" 2>/dev/null | xargs -L1 -I{} -- bash -c \"echo Linting {}; jsonlint -q {}\"'",
    "test:lint:eslint": "eslint --color apps/server/src/**/*.js apps/server/test/**/*.js apps/desktop/src/**/*.js developers/scripts/**/*.js",
    "test:lint:web": "pnpm --filter @axiocnc/web lint",
    "test:typecheck": "cd apps/web && pnpm typecheck",
    "test:lint:eslint-debug": "DEBUG=\"eslint:glob-util,eslint:config-*,eslint:cli*\" eslint --cache --color --quiet apps/server/src/**/*.js apps/server/test/**/*.js apps/desktop/src/**/*.js developers/scripts/**/*.js",
    "build:all": "pnpm build:server && pnpm build:web && pnpm build:shared && pnpm build:desktop",
    "build:server": "pnpm --filter @axiocnc/server run build",
    "build:web": "pnpm --filter @axiocnc/web run build",
    "build:shared": "pnpm --filter @axiocnc/shared run build",
    "build:desktop": "pnpm --filter @axiocnc/desktop run build",
    "package:desktop:linux-amd64": "node developers/scripts/desktop/package-desktop.js --linux --x64",
    "package:desktop:linux-arm64": "node developers/scripts/desktop/package-desktop.js --linux --arm64",
    "package:desktop:linux-armv7l": "node developers/scripts/desktop/package-desktop.js --linux --armv7l",
    "package:desktop:windows-x64": "node developers/scripts/desktop/package-desktop.js --win --x64",
    "package:desktop:macos-x64": "node developers/scripts/desktop/package-desktop.js --mac --x64",
    "package:desktop:macos-arm64": "node developers/scripts/desktop/package-desktop.js --mac --arm64",
    "package:server-amd64": "bash developers/scripts/packaging/package-headless.sh amd64",
    "package:server-arm64": "bash developers/scripts/packaging/package-headless.sh arm64",
    "package:server-armhf": "bash developers/scripts/packaging/package-headless.sh armhf",
    "package:server-docker": "docker build -t ghcr.io/rsteckler/axiocnc:latest .",
    "release:tag": "node developers/scripts/release.js",
    "release:tag:push": "node developers/scripts/release.js --push",
    "release:update-web-links": "node developers/scripts/update-web-links.js",
    "clean": "rimraf out build node_modules apps/server/dist apps/desktop/dist apps/web/dist apps/shared/dist apps/web/node_modules apps/server/node_modules apps/desktop/node_modules apps/shared/node_modules"
  },
  "keywords": [
    "cncjs",
    "axiocnc",
    "arduino",
    "raspberry",
    "pi",
    "cnc",
    "gcode",
    "grbl",
    "smoothie",
    "smoothieware",
    "tinyg",
    "g2core",
    "react",
    "socket.io"
  ],
  "dependencies": {
    "chalk": "~4.1.1",
    "i18next": "~15.0.9",
    "lodash": "~4.17.11",
    "mkdirp": "~0.5.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/eslint-plugin": "^7.25.9",
    "@babel/node": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@babel/register": "^7.25.9",
    "@electron/rebuild": "^4.0.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@trendmicro/babel-config": "~1.0.2",
    "babel-core": "~7.0.0-bridge.0",
    "babel-eslint": "~10.0.1",
    "babel-loader": "~8.0.5",
    "babel-plugin-lodash": "~3.3.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "boolean": "~1.0.0",
    "bundle-loader": "~0.5.6",
    "concurrently": "~4.1.0",
    "coveralls": "~3.0.3",
    "cross-env": "~5.2.0",
    "crypto-browserify": "^3.12.0",
    "css-loader": "~3.0.0",
    "del-cli": "~3.0.1",
    "dotenv": "~16.6.1",
    "electron-builder": "^26.4.0",
    "eslint": "^8.0.0",
    "eslint-config-trendmicro": "^3.2.0",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-webpack": "^0.13.9",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-webpack-plugin": "^4.2.0",
    "eventsource-polyfill": "~0.9.6",
    "file-loader": "~6.2.0",
    "find-imports": "~1.1.0",
    "glob": "~7.1.3",
    "html-webpack-plugin": "~5.6.0",
    "i18next-scanner": "~4.6.0",
    "imports-loader": "~0.8.0",
    "json-loader": "~0.5.7",
    "jsonlint": "^1.6.3",
    "mini-css-extract-plugin": "~2.9.0",
    "nib": "~1.2.0",
    "nodemon": "^3.1.11",
    "path-browserify": "^1.0.1",
    "pre-push": "~0.1.1",
    "progress": "~2.0.3",
    "proxyquire": "^2.1.3",
    "react-refresh": "^0.14.2",
    "redux-devtools": "~3.5.0",
    "rimraf": "^6.1.2",
    "run-sequence": "~2.2.1",
    "stream-browserify": "^3.0.0",
    "style-loader": "~0.23.1",
    "stylint": "~1.5.9",
    "stylint-loader": "~1.0.0",
    "stylus": "~0.63.0",
    "stylus-loader": "~8.1.0",
    "supertest": "^7.2.2",
    "tap": "^21.3.0",
    "text-table": "~0.2.0",
    "timers-browserify": "^2.0.12",
    "transform-loader": "~0.2.4",
    "url-loader": "~4.1.1",
    "webpack": "~5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-node-externals": "~1.7.2"
  },
  "pre-push": [
    "test:lint:eslint-debug"
  ],
  "tap": {
    "coverage": true,
    "coverage-report": "lcov",
    "coverage-report-html": true,
    "coverage-threshold": {
      "statements": 90,
      "branches": 85,
      "functions": 85,
      "lines": 90
    }
  }
}
